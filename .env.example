# --- Database ---
POSTGRES_USER=compliance
POSTGRES_PASSWORD=compliance
POSTGRES_DB=compliance
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://compliance:compliance@localhost:5432/compliance

# --- Auth ---
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-please-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720

# --- LLM provider abstraction ---
# One of: openai | anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Provider keys (set only the one(s) you use) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Privacy / security ---
DELETE_SOURCE_FILES_AFTER_PROCESSING=true
MAX_UPLOAD_BYTES=20971520        # 20 MiB
ALLOWED_UPLOAD_EXTENSIONS=pdf,docx,txt
STORAGE_DIR=./storage
TMP_DIR=./tmp

# --- Retrieval ---
CHUNK_TOKEN_SIZE=500
CHUNK_TOKEN_OVERLAP=50
RETRIEVAL_TOP_K=6

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
