# =============================================================================
# Compliance Reviewer — example environment
# Copy to .env and fill in values. Never commit your real .env.
# =============================================================================

# --- Auth ---
JWT_SECRET=change-me-please-use-a-long-random-string

# --- Database (SQLite + sqlite-vec) ---
# On Hugging Face Spaces, set DATABASE_PATH=/data/data.sqlite (persistent disk).
DATABASE_PATH=./data/data.sqlite

# --- LLM provider (default: Groq, free tier, no credit card) ---
# Get a free key at https://console.groq.com/keys
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

# Optional: if you'd rather use a paid provider, switch LLM_PROVIDER and fill
# in the matching key.
# LLM_PROVIDER=openai     # gpt-4o-mini etc.
# OPENAI_API_KEY=
# LLM_PROVIDER=anthropic  # claude-3-haiku etc.
# ANTHROPIC_API_KEY=

# --- Embeddings (default: fastembed, runs locally, no key needed) ---
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Privacy / security ---
DELETE_SOURCE_FILES_AFTER_PROCESSING=true
MAX_UPLOAD_BYTES=20971520
ALLOWED_UPLOAD_EXTENSIONS=pdf,docx,txt
STORAGE_DIR=./storage
TMP_DIR=./tmp

# --- Retrieval ---
CHUNK_TOKEN_SIZE=500
CHUNK_TOKEN_OVERLAP=50
RETRIEVAL_TOP_K=6

# --- App / CORS ---
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated; in production set this to your Vercel URL.
CORS_ORIGINS=http://localhost:3000
